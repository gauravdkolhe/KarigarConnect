# KarigarConnect Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security & JWT Secrets
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Database Connection
# If unset or unreachable, the system automatically falls back to in-memory mongomock
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=karigarconnect

# Google Gemini API
GEMINI_API_KEY=your-google-gemini-api-key

# Storage
STORAGE_DIR=storage
